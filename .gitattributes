# Normalize text in Git; retain existing working-tree line endings until checkout.
* text=auto
*.md text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
