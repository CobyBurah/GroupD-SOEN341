# Copy to .env.local and fill in from the Supabase dashboard (Connect dialog or Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: public base URL used in password reset links (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=
# Geoapify location autocomplete
GEOAPIFY_API_KEY=
# AI resume feedback: Ollama runs locally, no API key needed (see README)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
